# Copy this to .env locally, or set each of these in your host's
# "Environment Variables" panel (e.g. Render). Never commit real values.

JWT_SECRET=replace-with-a-long-random-string
UBER_CLIENT_ID=from-developer.uber.com-auth-tab
UBER_CLIENT_SECRET=from-developer.uber.com-auth-tab
UBER_REDIRECT_URI=https://your-deployed-url.onrender.com/auth/callback

# Leave unset (or "sandbox") while testing — no Uber approval needed.
# Set to "production" only after Uber approves your "request" scope.
UBER_ENV=sandbox
